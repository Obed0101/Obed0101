FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-gifos.txt ./
RUN python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-gifos.txt

CMD ["python", "main.py"]
